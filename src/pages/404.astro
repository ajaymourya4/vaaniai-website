---
import BaseLayout from '@layouts/BaseLayout.astro';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
---

<BaseLayout
  title="Page Not Found | Vaani"
  description="The page you're looking for doesn't exist or has moved."
  noindex
>
  <Header />
  <main class="section-container py-20 md:py-28 text-center">
    <h1 class="text-3xl md:text-4xl font-bold text-accent-blue">
      Page not found
    </h1>
    <p class="text-text-secondary leading-relaxed mt-4">
      The page you're looking for doesn't exist or has moved.
    </p>
    <p class="mt-8 flex justify-center gap-6">
      <a href="/" class="text-text-primary hover:text-accent-blue transition-colors underline">
        Home
      </a>
      <a href="/guides/" class="text-text-primary hover:text-accent-blue transition-colors underline">
        English speaking guides
      </a>
    </p>
  </main>
  <Footer />
</BaseLayout>
