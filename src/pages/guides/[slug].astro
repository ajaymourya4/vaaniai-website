---
import BaseLayout from '@layouts/BaseLayout.astro';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import DownloadButtons from '@components/DownloadButtons.astro';
import { guides, renderInline } from '@data/guides';
import { siteConfig } from '@data/seo';

export function getStaticPaths() {
  return guides.map((guide) => ({
    params: { slug: guide.slug },
    props: { guide },
  }));
}

const { guide } = Astro.props;
const relatedGuides = guides.filter((g) => guide.related.includes(g.slug));
const pageUrl = `${siteConfig.url}/guides/${guide.slug}/`;
const updatedLabel = new Date(guide.updatedAt).toLocaleDateString('en-IN', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
});

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: guide.title,
  description: guide.metaDescription,
  image: new URL(guide.vaani.screenshot.src, siteConfig.url).href,
  datePublished: guide.publishedAt,
  dateModified: guide.updatedAt,
  author: guide.author
    ? { '@type': 'Person', ...guide.author }
    : { '@type': 'Organization', name: 'Vaani', url: siteConfig.url },
  publisher: {
    '@type': 'Organization',
    name: 'Vaani',
    logo: { '@type': 'ImageObject', url: `${siteConfig.url}/favicon.svg` },
  },
  mainEntityOfPage: pageUrl,
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: guide.faqs.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: siteConfig.url },
    { '@type': 'ListItem', position: 2, name: 'Guides', item: `${siteConfig.url}/guides/` },
    { '@type': 'ListItem', position: 3, name: guide.title, item: pageUrl },
  ],
};
---

<BaseLayout
  title={guide.metaTitle}
  description={guide.metaDescription}
  ogType="article"
  schemas={[articleSchema, faqSchema, breadcrumbSchema]}
>
  <Header />
  <main id="main-content">
    <article class="py-14 lg:py-20">
      <div class="section-container max-w-3xl">
        <nav aria-label="Breadcrumb" class="text-sm text-text-muted">
          <ol class="flex flex-wrap items-center gap-2">
            <li><a href="/" class="hover:text-text-primary transition-colors">Home</a></li>
            <li aria-hidden="true">/</li>
            <li><a href="/guides/" class="hover:text-text-primary transition-colors">Guides</a></li>
            <li aria-hidden="true">/</li>
            <li aria-current="page" class="text-text-secondary">{guide.keyword}</li>
          </ol>
        </nav>

        <h1 class="text-3xl md:text-4xl lg:text-5xl font-extrabold leading-tight mt-6">
          {guide.title}
        </h1>
        <p class="text-text-muted text-sm mt-4">
          {guide.author && <>By {guide.author.url ? <a href={guide.author.url} class="hover:text-text-primary transition-colors underline">{guide.author.name}</a> : guide.author.name} · </>}
          Updated <time datetime={guide.updatedAt}>{updatedLabel}</time>
        </p>
        <p class="text-text-secondary text-lg mt-6 leading-relaxed border-l-2 border-accent-blue pl-5">
          {guide.intro}
        </p>

        {guide.sections.map((section) => (
          <section class="mt-12">
            <h2 class="text-2xl lg:text-3xl font-bold">{section.heading}</h2>
            {section.blocks.map((block) => (
              <>
                {block.type === 'p' && (
                  <p class="text-text-secondary mt-4 leading-relaxed" set:html={renderInline(block.text)} />
                )}
                {block.type === 'list' && (
                  <ul class="mt-4 space-y-3">
                    {block.items.map((item) => (
                      <li class="flex gap-3 text-text-secondary leading-relaxed">
                        <span class="text-accent-blue mt-1 shrink-0" aria-hidden="true">✓</span>
                        <span set:html={renderInline(item)} />
                      </li>
                    ))}
                  </ul>
                )}
                {block.type === 'steps' && (
                  <ol class="mt-6 space-y-5">
                    {block.items.map((item, i) => (
                      <li class="rounded-2xl bg-dark-card border border-dark-border/60 p-6">
                        <h3 class="font-semibold text-lg flex items-start gap-3">
                          <span class="w-7 h-7 rounded-lg bg-gradient-to-br from-brand-blue to-accent-purple flex items-center justify-center text-white text-sm font-bold shrink-0">
                            {i + 1}
                          </span>
                          {item.title}
                        </h3>
                        <p class="text-text-secondary mt-2 leading-relaxed text-[0.95rem]" set:html={renderInline(item.text)} />
                      </li>
                    ))}
                  </ol>
                )}
                {block.type === 'table' && (
                  <div class="mt-6 overflow-x-auto rounded-2xl border border-dark-border">
                    <table class="w-full text-left text-[0.95rem]">
                      <thead class="bg-dark-card">
                        <tr>
                          {block.head.map((cell) => (
                            <th scope="col" class="px-4 py-3 font-semibold text-text-primary">{cell}</th>
                          ))}
                        </tr>
                      </thead>
                      <tbody>
                        {block.rows.map((row) => (
                          <tr class="border-t border-dark-border">
                            {row.map((cell) => (
                              <td class="px-4 py-3 text-text-secondary align-top leading-relaxed" set:html={renderInline(cell)} />
                            ))}
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  </div>
                )}
                {block.type === 'example' && (
                  <figure class="mt-6 rounded-2xl bg-dark-card border-l-4 border-accent-blue p-6">
                    {block.label && (
                      <figcaption class="text-xs font-semibold uppercase tracking-wider text-accent-blue mb-3">{block.label}</figcaption>
                    )}
                    <blockquote class="space-y-3 text-text-primary leading-relaxed">
                      {block.text.split('\n\n').map((para) => <p>{para}</p>)}
                    </blockquote>
                  </figure>
                )}
              </>
            ))}
          </section>
        ))}

        <section class="mt-14 rounded-3xl glow-border glow-blue p-8 lg:p-10">
          <h2 class="text-2xl lg:text-3xl font-bold gradient-text inline-block">{guide.vaani.heading}</h2>
          <p class="text-text-secondary mt-4 leading-relaxed">{guide.vaani.intro}</p>
          <div class="grid md:grid-cols-[1fr_auto] gap-8 mt-8 items-start">
            <ol class="space-y-4">
              {guide.vaani.steps.map((step, i) => (
                <li class="flex gap-3 text-text-secondary leading-relaxed">
                  <span class="w-6 h-6 rounded-full bg-accent-blue/20 text-accent-blue flex items-center justify-center text-xs font-bold shrink-0 mt-0.5">
                    {i + 1}
                  </span>
                  <span>{step}</span>
                </li>
              ))}
            </ol>
            <img
              src={guide.vaani.screenshot.src}
              alt={guide.vaani.screenshot.alt}
              width="236"
              height="512"
              loading="lazy"
              class="rounded-2xl border border-dark-border mx-auto w-[200px] md:w-[220px]"
            />
          </div>
          <div class="mt-8 flex flex-col items-center gap-3">
            <DownloadButtons />
            <p class="text-text-muted text-sm">Free to start · Available 24/7</p>
          </div>
        </section>

        <section class="mt-14" aria-labelledby="guide-faq-heading">
          <h2 id="guide-faq-heading" class="text-2xl lg:text-3xl font-bold">Frequently Asked Questions</h2>
          <div class="mt-6 space-y-4">
            {guide.faqs.map((item) => (
              <details class="group rounded-2xl border border-dark-border bg-dark-card overflow-hidden">
                <summary class="flex justify-between items-center cursor-pointer p-6 font-semibold select-none [&::-webkit-details-marker]:hidden list-none">
                  <span>{item.question}</span>
                  <span class="ml-4 shrink-0 transition-transform duration-200 group-open:rotate-45 text-2xl text-accent-blue">+</span>
                </summary>
                <div class="px-6 pb-6 text-text-secondary leading-relaxed">{item.answer}</div>
              </details>
            ))}
          </div>
        </section>

        <section class="mt-14" aria-labelledby="related-heading">
          <h2 id="related-heading" class="text-xl font-bold">Related Guides</h2>
          <ul class="mt-4 grid sm:grid-cols-3 gap-4">
            {relatedGuides.map((related) => (
              <li>
                <a
                  href={`/guides/${related.slug}/`}
                  class="block h-full rounded-2xl bg-dark-card border border-dark-border/60 hover:border-accent-blue/40 transition-colors p-5 text-sm font-semibold leading-snug"
                >
                  {related.title}
                  <span class="block text-accent-blue mt-2 font-normal">Read guide →</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      </div>
    </article>
  </main>
  <Footer />
</BaseLayout>
