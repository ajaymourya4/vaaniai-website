---
import DownloadButtons from './DownloadButtons.astro';
---

<section id="hero" aria-labelledby="hero-heading" class="pt-20 pb-24 lg:pt-32 lg:pb-32">
  <div class="section-container">
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      <div>
        <p class="text-accent-purple font-semibold tracking-wide uppercase text-sm mb-4">
          AI-Powered English Coach
        </p>
        <h1 id="hero-heading" class="text-5xl lg:text-7xl font-extrabold leading-[1.1]">
          Speak English<br />
          <span class="gradient-text">with Confidence</span>
        </h1>
        <p class="text-text-secondary text-xl mt-6 max-w-lg leading-relaxed">
          Practice real conversations with an AI coach that gives you instant feedback
          on grammar, pronunciation, and vocabulary. Build fluency — on your schedule.
        </p>
        <div class="mt-8">
          <DownloadButtons />
        </div>
        <p class="text-text-muted text-sm mt-4">Free to start. No credit card required.</p>
      </div>
      <div class="relative flex justify-center">
        <div class="absolute inset-0 bg-gradient-to-r from-accent-purple/20 to-accent-blue/20 blur-3xl rounded-full"></div>
        <div class="relative z-10 w-64 h-[520px] rounded-[2.5rem] border-2 border-dark-border bg-dark-surface flex items-center justify-center">
          <div class="text-center px-6">
            <div class="w-16 h-16 rounded-2xl bg-gradient-to-r from-accent-purple to-accent-blue flex items-center justify-center mx-auto mb-4">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z" />
                <path d="M19 10v2a7 7 0 0 1-14 0v-2" />
                <line x1="12" x2="12" y1="19" y2="22" />
              </svg>
            </div>
            <p class="text-text-primary font-semibold">Vaani</p>
            <p class="text-text-muted text-sm mt-1">Tap to start speaking</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
