---
import DownloadButtons from './DownloadButtons.astro';
---

<section id="hero" aria-labelledby="hero-heading" class="pt-24 pb-28 lg:pt-40 lg:pb-40">
  <div class="section-container max-w-3xl text-center">
    <h1 id="hero-heading" class="text-4xl md:text-5xl lg:text-7xl font-extrabold leading-[1.1]">
      Speak English<br />
      <span class="gradient-text">with Confidence</span>
    </h1>
    <p class="text-text-secondary text-xl mt-6 max-w-xl mx-auto leading-relaxed">
      Improve your English speaking with an AI coach that gives instant feedback
      on grammar, pronunciation, and vocabulary. Practice real conversations
      and build fluency — anytime, anywhere.
    </p>
    <div class="mt-8 flex justify-center">
      <DownloadButtons />
    </div>
    <p class="text-text-secondary text-sm mt-4 flex items-center justify-center gap-2">
      <span class="inline-block w-2 h-2 rounded-full bg-green-400"></span>
      Get started for free
    </p>
  </div>
</section>
