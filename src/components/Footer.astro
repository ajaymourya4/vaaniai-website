---
const year = new Date().getFullYear();
---

<footer class="border-t border-dark-border py-12">
  <div class="section-container">
    <div class="grid md:grid-cols-4 gap-8">
      <div class="md:col-span-2">
        <p class="text-2xl font-bold gradient-text">Vaani</p>
        <p class="text-text-secondary mt-2 max-w-sm text-sm leading-relaxed">
          Your AI-powered English speaking coach. Practice real conversations, get instant feedback, build confidence.
        </p>
      </div>
      <nav aria-label="Product links">
        <h3 class="font-semibold text-sm uppercase tracking-wider text-text-muted mb-4">
          Product
        </h3>
        <ul class="space-y-2 text-sm">
          <li>
            <a href="#how-it-works" class="text-text-secondary hover:text-text-primary transition-colors">
              How It Works
            </a>
          </li>
          <li>
            <a href="#features" class="text-text-secondary hover:text-text-primary transition-colors">
              Features
            </a>
          </li>
          <li>
            <a href="#faq" class="text-text-secondary hover:text-text-primary transition-colors">
              FAQ
            </a>
          </li>
        </ul>
      </nav>
      <nav aria-label="Legal links">
        <h3 class="font-semibold text-sm uppercase tracking-wider text-text-muted mb-4">
          Legal
        </h3>
        <ul class="space-y-2 text-sm">
          <li>
            <a href="#" class="text-text-secondary hover:text-text-primary transition-colors">
              Privacy Policy
            </a>
          </li>
          <li>
            <a href="#" class="text-text-secondary hover:text-text-primary transition-colors">
              Terms of Service
            </a>
          </li>
          <li>
            <a href="#" class="text-text-secondary hover:text-text-primary transition-colors">
              Contact
            </a>
          </li>
        </ul>
      </nav>
    </div>
    <div class="border-t border-dark-border mt-8 pt-8 flex flex-col md:flex-row justify-between items-center gap-4 text-text-muted text-sm">
      <p>&copy; {year} Vaani. All rights reserved.</p>
      <div class="flex gap-6">
        <a href="#" aria-label="Follow Vaani on Twitter" class="hover:text-text-primary transition-colors">
          Twitter
        </a>
        <a href="#" aria-label="Follow Vaani on Instagram" class="hover:text-text-primary transition-colors">
          Instagram
        </a>
        <a href="#" aria-label="Vaani on LinkedIn" class="hover:text-text-primary transition-colors">
          LinkedIn
        </a>
      </div>
    </div>
  </div>
</footer>
