---
import AppleIcon from './icons/AppleIcon.astro';
import PlayStoreIcon from './icons/PlayStoreIcon.astro';

interface Props {
  size?: 'default' | 'large';
}

const { size = 'default' } = Astro.props;
const isLarge = size === 'large';
---

<div class="flex flex-wrap gap-4">
  <a
    href="#"
    class:list={[
      'inline-flex items-center gap-3 rounded-xl bg-white text-black font-semibold transition-colors hover:bg-gray-100',
      isLarge ? 'px-8 py-4 text-lg' : 'px-6 py-3 text-base',
    ]}
  >
    <AppleIcon class={isLarge ? 'w-7 h-7' : 'w-5 h-5'} />
    <span>
      <span class="block text-xs font-normal leading-none">Download on the</span>
      <span class="leading-tight">App Store</span>
    </span>
  </a>
  <a
    href="#"
    class:list={[
      'inline-flex items-center gap-3 rounded-xl border border-white/20 text-white font-semibold transition-colors hover:bg-white/5',
      isLarge ? 'px-8 py-4 text-lg' : 'px-6 py-3 text-base',
    ]}
  >
    <PlayStoreIcon class={isLarge ? 'w-7 h-7' : 'w-5 h-5'} />
    <span>
      <span class="block text-xs font-normal leading-none">Get it on</span>
      <span class="leading-tight">Google Play</span>
    </span>
  </a>
</div>
