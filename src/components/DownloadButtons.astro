---
interface Props {
  size?: 'default' | 'large';
}

const { size = 'default' } = Astro.props;
const isLarge = size === 'large';
---

<div class="flex flex-wrap items-center gap-3">
  <a
    href="#"
    class:list={[
      'inline-flex items-center gap-3 rounded-xl border border-white/50 text-white font-semibold transition-opacity hover:opacity-80',
      isLarge ? 'px-8 py-4 text-lg' : 'px-6 py-3 text-base',
    ]}
  >
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class:list={[isLarge ? 'w-9 h-9' : 'w-7 h-7']}>
      <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.8-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/>
    </svg>
    <span class="text-left">
      <span class:list={["block font-normal leading-none", isLarge ? 'text-xs' : 'text-[10px]']}>Download on the</span>
      <span class="leading-tight">App Store</span>
    </span>
  </a>
  <a
    href="#"
    class:list={[
      'inline-flex items-center gap-3 rounded-xl border border-white/50 text-white font-semibold transition-opacity hover:opacity-80',
      isLarge ? 'px-8 py-4 text-lg' : 'px-6 py-3 text-base',
    ]}
  >
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" class:list={[isLarge ? 'w-7 h-7' : 'w-5 h-5']}>
      <path d="M325.3 234.3L104.6 13l280.8 161.2-60.1 60.1zM47 0C34 6.8 25.3 19.2 25.3 35.3v441.3c0 16.1 8.7 28.5 21.7 35.3l256.6-256L47 0zm425.2 225.6l-58.9-34.1-65.7 64.5 65.7 64.5 60.1-34.1c18-14.3 18-46.5-1.2-60.8zM104.6 499l280.8-161.2-60.1-60.1L104.6 499z" fill="#fff"/>
    </svg>
    <span class="text-left">
      <span class:list={["block font-normal leading-none", isLarge ? 'text-xs' : 'text-[10px]']}>Get it on</span>
      <span class="leading-tight">Google Play</span>
    </span>
  </a>
</div>
