---
import '../styles/global.css';
import { siteConfig } from '@data/seo';
import { faqData } from '@data/faq';
import PostHog from '@components/posthog.astro';

interface Props {
  title?: string;
  description?: string;
  ogType?: 'website' | 'article';
  schemas?: object[];
  noindex?: boolean;
}

const {
  title = siteConfig.title,
  description = siteConfig.description,
  ogType = 'website',
  schemas = [],
  noindex = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, siteConfig.url);
const isHome = Astro.url.pathname === '/';
const playUrl = 'https://play.google.com/store/apps/details?id=app.getvaani';

const applicationSchema = {
  '@context': 'https://schema.org',
  '@type': 'MobileApplication',
  name: 'Vaani',
  alternateName: 'Vaani AI - English Speaking',
  description: siteConfig.description,
  url: `${siteConfig.url}/`,
  applicationCategory: 'EducationalApplication',
  operatingSystem: 'Android',
  downloadUrl: playUrl,
  installUrl: playUrl,
  screenshot: `${siteConfig.url}/images/screenshots/vaani-practice-hub-english-speaking-topics.jpg`,
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
    availability: 'https://schema.org/InStock',
  },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqData.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
};

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Vaani',
  alternateName: 'Vaani AI',
  url: siteConfig.url,
  logo: `${siteConfig.url}/favicon.svg`,
  sameAs: [
    playUrl,
    'https://twitter.com/vaaniapp',
    'https://instagram.com/vaaniapp',
  ],
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: siteConfig.url,
    },
  ],
};
---

<!doctype html>
<html lang="en" dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={siteConfig.keywords.join(', ')} />
    <link rel="canonical" href={canonicalURL.href} />

    <meta
      name="robots"
      content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'}
    />

    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta
      property="og:image"
      content={new URL(siteConfig.ogImage, siteConfig.url).href}
    />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Vaani - AI English Speaking Coach"
    />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:locale" content={siteConfig.locale} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={siteConfig.twitterHandle} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta
      name="twitter:image"
      content={new URL(siteConfig.ogImage, siteConfig.url).href}
    />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="text/markdown" href="/llms.txt" title="LLM-friendly site information" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
        rel="stylesheet"
      />
    </noscript>

    {isHome && (
      <script
        type="application/ld+json"
        set:html={JSON.stringify(applicationSchema)}
      />
    )}
    <script
      type="application/ld+json"
      set:html={JSON.stringify(organizationSchema)}
    />
    {isHome && (
      <script
        type="application/ld+json"
        set:html={JSON.stringify(faqSchema)}
      />
    )}
    {isHome && (
      <script
        type="application/ld+json"
        set:html={JSON.stringify(breadcrumbSchema)}
      />
    )}
    {schemas.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}

    {import.meta.env.PROD && <PostHog />}

    <meta name="theme-color" content="#0a0c10" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
  </head>
  <body class="bg-dark-bg text-text-primary antialiased overflow-x-hidden">
    <slot />
  </body>
</html>
